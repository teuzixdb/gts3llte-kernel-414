# gts3llte_defconfig para kernel 4.14 (port do 3.18 awesometic/jaydens)
# Samsung Galaxy Tab S3 LTE (SM-T825) - Snapdragon 820 (msm8996)
# Baseado no defconfig do jaydens-3.18, adaptado para 4.14 CAF
#
# v2: Removidas configs Samsung-especÃ­ficas que podem nÃ£o existir no 4.14 CAF
#     para facilitar o primeiro build. SerÃ£o adicionadas progressivamente.

# ---- Arquitetura e Platform ----
CONFIG_ARM64=y
CONFIG_ARCH_QCOM=y
CONFIG_ARCH_MSM=y
CONFIG_ARCH_MSM8996=y

# ---- Kernel Core ----
CONFIG_LOCALVERSION="-gts3llte-4.14-port"
CONFIG_PREEMPT=y
CONFIG_HZ_300=y
CONFIG_HZ=300
CONFIG_NR_CPUS=4
CONFIG_SMP=y
CONFIG_HOTPLUG_CPU=y

# ---- Scheduler / WALT ----
CONFIG_SCHED_WALT=y
CONFIG_SCHED_MC=y
CONFIG_SCHED_HRTICK=y
# CONFIG_SCHED_TUNE is not set (depende de backport)
# CONFIG_CGROUP_SCHEDTUNE is not set
# CONFIG_DYNAMIC_STUNE_BOOST is not set

# ---- CPU Freq / Governors ----
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y

# ---- Idle ----
CONFIG_CPU_IDLE=y
CONFIG_CPU_IDLE_GOV_MENU=y

# ---- Memory / ZRAM / CMA ----
CONFIG_SWAP=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_MEMCG_SWAP_ENABLED=y
CONFIG_CMA=y
CONFIG_CMA_AREAS=7
CONFIG_ZSMALLOC=y
CONFIG_ZSWAP=y
CONFIG_ZPOOL=y
CONFIG_FRONTSWAP=y
CONFIG_COMPACTION=y
CONFIG_MIGRATION=y
CONFIG_SPARSEMEM_VMEMMAP=y

# ---- Cgroups ----
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y

# ---- Android Binder / IPC ----
CONFIG_ANDROID=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_ANDROID_BINDERFS=y
CONFIG_ASHMEM=y

# ---- ION Memory Manager ----
CONFIG_STAGING=y
CONFIG_ION=y
CONFIG_ION_MSM=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_MSM_IOMMU=y

# ---- Display (MDSS FB) ----
CONFIG_FB=y
CONFIG_FB_MSM=y
CONFIG_FB_MSM_MDSS=y
CONFIG_FB_MSM_MDSS_DSI=y

# ---- I2C Bus ----
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_MSM_V2=y

# ---- GPU / KGSL / Adreno 530 ----
CONFIG_MSM_KGSL=y
CONFIG_QCOM_KGSL=y
CONFIG_QCOM_KGSL_IOMMU=y
CONFIG_CORESIGHT=y

# ---- Touchscreen Synaptics (DSX v2.6) ----
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_v26=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_CORE_v26=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_RMI_DEV_v26=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_FW_UPDATE_v26=y

# ---- Audio QDSP6 (desabilitado no 1o build para evitar erros em cascata) ----
# CONFIG_SND_SOC_MSM8996 is not set

# ---- USB / ADB ----
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_MSM=y
CONFIG_USB_DWC3_GADGET=y

# ---- LEDs / Backlight ----
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y

# ---- eMMC ----
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_MSM=y

# ---- Filesystem ----
CONFIG_EXT4_FS=y
CONFIG_F2FS_FS=y
CONFIG_FUSE_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_VFAT_FS=y

# ---- Security / SELinux ----
CONFIG_SECURITY=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_BOOTPARAM_VALUE=0
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y

# ---- ARM64 errata ----
CONFIG_ARM64_ERRATUM_826319=y
CONFIG_ARM64_ERRATUM_827319=y
CONFIG_ARM64_ERRATUM_824069=y
CONFIG_ARM64_ERRATUM_832075=y
CONFIG_ARM64_ERRATUM_845719=y
CONFIG_ARM64_ERRATUM_843419=y

# ---- Misc Android ----
CONFIG_ANDROID_LOW_MEMORY_KILLER=y
CONFIG_SW_SYNC=y
CONFIG_SW_SYNC_USER=y
CONFIG_SYNC_FILE=y
CONFIG_POWER_SUPPLY=y

# ---- Networking ----
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_ANDROID_PARANOID_NETWORK=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y

# ---- Debug & PStore / Ramoops ----
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_DEBUG_FS=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# ---- Serial / Console ----
CONFIG_SERIAL_MSM=y
CONFIG_SERIAL_MSM_CONSOLE=y
CONFIG_SERIAL_MSM_HS=y

# ---- Qualcomm Core & Clocks ----
CONFIG_QCOM_SCM=y
CONFIG_COMMON_CLK_QCOM=y
CONFIG_MSM_GCC_8996=y
CONFIG_MSM_MMCC_8996=y
CONFIG_QCOM_CLK_SMD_RPM=y

# ---- Pin Controller & SPMI ----
CONFIG_PINCTRL_MSM8996=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y

# ---- Regulators ----
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_RPM_SMD=y
CONFIG_REGULATOR_QCOM_SPMI=y
CONFIG_REGULATOR_QPNP_LABIBB=y

# ---- SoC / Interconnect / RPM & RPMSG ----
CONFIG_HWSPINLOCK=y
CONFIG_HWSPINLOCK_QCOM=y
CONFIG_MAILBOX=y
CONFIG_QCOM_APCS_IPC=y
CONFIG_RPMSG=y
CONFIG_RPMSG_CHAR=y
CONFIG_RPMSG_QCOM_SMD=y
CONFIG_MSM_RPM_SMD=y
CONFIG_QCOM_SMD_RPM=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMP2P=y
CONFIG_MSM_SPM=y
CONFIG_SOC_BUS=y
CONFIG_QCOM_WATCHDOG_V2=y
CONFIG_QCOM_MEMORY_DUMP_V2=y
CONFIG_MSM_BOOT_STATS=y

# devfreq (required by MMC clock scaling)
CONFIG_PM_DEVFREQ=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y
CONFIG_DEVFREQ_GOV_PERFORMANCE=y
# Samsung project selection
CONFIG_SEC_GTS3LLTE_PROJECT=y
CONFIG_MACH_GTS3LLTE_XX=y
# Appended DTB Image for Samsung bootloader
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE=y
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE_NAMES=""
CONFIG_BUILD_ARM64_KERNEL_COMPRESSION_GZIP=y
